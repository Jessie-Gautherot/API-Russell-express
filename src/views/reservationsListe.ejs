<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Liste des réservations</title>
</head>
<body>
  <h1>Liste complète des réservations</h1>

  <table border="1">
    <thead>
      <tr>
        <th>Catway</th>
        <th>Client</th>
        <th>Bateau</th>
        <th>Check-in</th>
        <th>Check-out</th>
      </tr>
    </thead>
    <tbody>
      <% reservations.forEach(r => { %>
        <tr>
          <td><%= r.catwayNumber %></td>
          <td><%= r.clientName %></td>
          <td><%= r.boatName %></td>
          <td><%= r.checkIn.toISOString().slice(0,10) %></td>
          <td><%= r.checkOut.toISOString().slice(0,10) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <a href="/dashboard">Retour au dashboard</a>
</body>
</html>